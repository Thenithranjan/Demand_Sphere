# =============================================================
# Demand Sphere - Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file.
# =============================================================

# ─── Supabase PostgreSQL (SQLAlchemy direct connection) ───────────────────────
# Found in: Supabase Dashboard → Settings → Database → Connection string
SUPABASE_DB_HOST=db.xxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_DB_NAME=postgres

# ─── Supabase Client (Storage API) ───────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key   # Use service_role, NOT anon key

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Create this bucket in: Supabase Dashboard → Storage → New bucket
SUPABASE_STORAGE_BUCKET=reports

# ─── Application Security ─────────────────────────────────────────────────────
SECRET_KEY=your_super_secret_key_here_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS Origins (comma-separated list of allowed frontend origins) ──────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
