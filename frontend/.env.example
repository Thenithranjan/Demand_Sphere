# Retail AI Frontend - Environment Variables Template
# Set your backend API base URL here (must start with VITE_ for Vite projects)

# Local Development:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Render Production Backend Example:
# VITE_API_BASE_URL=https://retail-ai-backend.onrender.com/api/v1

# Vercel Production Backend Example:
